# OpenAI API Key - get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_api_key_here

# Chat model for resume parsing and job skill extraction
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embeddings model for semantic skill / domain matching
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Cosine similarity threshold (0–1) to count a skill as matched
SKILL_MATCH_THRESHOLD=0.72

# Upload settings
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
DATA_DIR=./data
